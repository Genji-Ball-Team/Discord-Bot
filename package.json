{
  "name": "genjiball-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Genji Ball Discord bot: leaderboard, stats and tourney posts, on Cloudflare Workers",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "register": "node scripts/register.mjs",
    "db:setup": "wrangler d1 execute genjiball-discord-bot --remote --file=schema.sql",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
